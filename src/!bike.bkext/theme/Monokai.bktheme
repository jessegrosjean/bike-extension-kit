{
  "metadata": {
    "name": "Monokai",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "background": "#272822",
    "backgroundLight": "#3e3d32",
    "foreground": "#f8f8f2",
    "comment": "#75715e",
    "red": "#f92672",
    "orange": "#fd971f",
    "yellow": "#e6db74",
    "green": "#a6e22e",
    "cyan": "#66d9ef",
    "purple": "#ae81ff",

    "text": "$foreground",
    "secondaryText": "$comment",
    "accent": "$cyan",
    "caret": "$foreground",
    "caretLine": "rgba(255, 255, 255, 0.05)",
    "textBackgroundSelected": "rgba(102, 217, 239, 0.3)",
    "blockBackgroundSelected": "rgba(102, 217, 239, 0.15)",
    "findMatch": "rgba(230, 219, 116, 0.35)",
    "findMatchCurrent": "rgba(230, 219, 116, 0.55)",
    "handle": "$comment",
    "guideLine": "$backgroundLight",
    "focusArrow": "$comment",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$background",
    "titlebar": "#1e1f1c",
    "sidebar": "#1e1f1c",
    "editor": "$background"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$red",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$comment"
    },
    "blockquote": {
      "color": "$yellow",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$green",
      "backgroundColor": "$backgroundLight",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$comment"
    }
  },
  "runs": {
    "strong": {
      "color": "$orange",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "color": "$yellow",
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$comment",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$purple",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$backgroundLight"
    },
    "highlight": {
      "backgroundColor": "rgba(230, 219, 116, 0.3)"
    },
    "link": {
      "color": "$cyan",
      "underline": {
        "single": true
      }
    }
  }
}
