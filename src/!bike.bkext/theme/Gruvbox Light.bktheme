{
  "metadata": {
    "name": "Gruvbox Light",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "light"
  },
  "colors": {
    "bg": "#fbf1c7",
    "bg1": "#ebdbb2",
    "bg2": "#d5c4a1",
    "fg": "#3c3836",
    "fg1": "#504945",
    "gray": "#928374",
    "red": "#cc241d",
    "green": "#98971a",
    "yellow": "#d79921",
    "blue": "#458588",
    "purple": "#b16286",
    "aqua": "#689d6a",
    "orange": "#d65d0e",

    "text": "$fg",
    "secondaryText": "$gray",
    "accent": "$blue",
    "background": "$bg",
    "caret": "$fg",
    "caretLine": "rgba(0, 0, 0, 0.04)",
    "textBackgroundSelected": "rgba(69, 133, 136, 0.25)",
    "blockBackgroundSelected": "rgba(69, 133, 136, 0.12)",
    "findMatch": "rgba(215, 153, 33, 0.3)",
    "findMatchCurrent": "rgba(215, 153, 33, 0.5)",
    "handle": "$gray",
    "guideLine": "$bg1",
    "focusArrow": "$gray",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$bg",
    "titlebar": "$bg1",
    "sidebar": "$bg1",
    "editor": "$bg"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$orange",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$gray"
    },
    "blockquote": {
      "color": "$aqua",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$fg1",
      "backgroundColor": "$bg1",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$gray"
    }
  },
  "runs": {
    "strong": {
      "color": "$fg1",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$gray",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$purple",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$bg1"
    },
    "highlight": {
      "backgroundColor": "rgba(215, 153, 33, 0.25)"
    },
    "link": {
      "color": "$blue",
      "underline": {
        "single": true
      }
    }
  }
}
