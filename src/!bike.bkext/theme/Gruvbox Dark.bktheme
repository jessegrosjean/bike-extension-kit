{
  "metadata": {
    "name": "Gruvbox Dark",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "bg": "#282828",
    "bg1": "#3c3836",
    "bg2": "#504945",
    "fg": "#ebdbb2",
    "fg1": "#d5c4a1",
    "gray": "#928374",
    "red": "#fb4934",
    "green": "#b8bb26",
    "yellow": "#fabd2f",
    "blue": "#83a598",
    "purple": "#d3869b",
    "aqua": "#8ec07c",
    "orange": "#fe8019",

    "text": "$fg",
    "secondaryText": "$gray",
    "accent": "$blue",
    "background": "$bg",
    "caret": "$fg",
    "caretLine": "rgba(255, 255, 255, 0.03)",
    "textBackgroundSelected": "rgba(131, 165, 152, 0.3)",
    "blockBackgroundSelected": "rgba(131, 165, 152, 0.15)",
    "findMatch": "rgba(250, 189, 47, 0.3)",
    "findMatchCurrent": "rgba(250, 189, 47, 0.5)",
    "handle": "$gray",
    "guideLine": "$bg1",
    "focusArrow": "$gray",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$bg",
    "titlebar": "#1d2021",
    "sidebar": "#1d2021",
    "editor": "$bg"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$orange",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$gray"
    },
    "blockquote": {
      "color": "$aqua",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$fg1",
      "backgroundColor": "$bg1",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$gray"
    }
  },
  "runs": {
    "strong": {
      "color": "$fg1",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$gray",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$purple",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$bg1"
    },
    "highlight": {
      "backgroundColor": "rgba(250, 189, 47, 0.25)"
    },
    "link": {
      "color": "$blue",
      "underline": {
        "single": true
      }
    }
  }
}
