{
  "metadata": {
    "name": "One Light",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "light"
  },
  "colors": {
    "background": "#fafafa",
    "backgroundAlt": "#f0f0f0",
    "foreground": "#383a42",
    "comment": "#a0a1a7",
    "red": "#e45649",
    "orange": "#c18401",
    "yellow": "#986801",
    "green": "#50a14f",
    "cyan": "#0184bc",
    "blue": "#4078f2",
    "purple": "#a626a4",

    "text": "$foreground",
    "secondaryText": "$comment",
    "accent": "$blue",
    "caret": "$foreground",
    "caretLine": "rgba(0, 0, 0, 0.04)",
    "textBackgroundSelected": "rgba(64, 120, 242, 0.2)",
    "blockBackgroundSelected": "rgba(64, 120, 242, 0.1)",
    "findMatch": "rgba(152, 104, 1, 0.25)",
    "findMatchCurrent": "rgba(152, 104, 1, 0.45)",
    "handle": "$comment",
    "guideLine": "$backgroundAlt",
    "focusArrow": "$comment",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$background",
    "titlebar": "#e5e5e6",
    "sidebar": "#eaeaeb",
    "editor": "$background"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$red",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$comment"
    },
    "blockquote": {
      "color": "$green",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$foreground",
      "backgroundColor": "$backgroundAlt",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$comment"
    }
  },
  "runs": {
    "strong": {
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$comment",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$purple",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$backgroundAlt"
    },
    "highlight": {
      "backgroundColor": "rgba(193, 132, 1, 0.2)"
    },
    "link": {
      "color": "$blue",
      "underline": {
        "single": true
      }
    }
  }
}
