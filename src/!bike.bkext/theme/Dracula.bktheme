{
  "metadata": {
    "name": "Dracula",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "background": "#282a36",
    "currentLine": "#44475a",
    "foreground": "#f8f8f2",
    "comment": "#6272a4",
    "cyan": "#8be9fd",
    "green": "#50fa7b",
    "orange": "#ffb86c",
    "pink": "#ff79c6",
    "purple": "#bd93f9",
    "red": "#ff5555",
    "yellow": "#f1fa8c",

    "text": "$foreground",
    "secondaryText": "$comment",
    "accent": "$purple",
    "caret": "$foreground",
    "caretLine": "rgba(68, 71, 90, 0.5)",
    "textBackgroundSelected": "rgba(189, 147, 249, 0.3)",
    "blockBackgroundSelected": "rgba(189, 147, 249, 0.15)",
    "findMatch": "rgba(241, 250, 140, 0.3)",
    "findMatchCurrent": "rgba(241, 250, 140, 0.5)",
    "handle": "$comment",
    "guideLine": "$currentLine",
    "focusArrow": "$comment",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$background",
    "titlebar": "#21222c",
    "sidebar": "#21222c",
    "editor": "$background"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$pink",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$comment"
    },
    "blockquote": {
      "color": "$yellow",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$green",
      "backgroundColor": "$currentLine",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$comment"
    }
  },
  "runs": {
    "strong": {
      "color": "$orange",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "color": "$yellow",
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$comment",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$cyan",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$currentLine"
    },
    "highlight": {
      "backgroundColor": "rgba(241, 250, 140, 0.25)"
    },
    "link": {
      "color": "$cyan",
      "underline": {
        "single": true
      }
    }
  }
}
