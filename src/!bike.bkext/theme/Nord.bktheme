{
  "metadata": {
    "name": "Nord",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "nord0": "#2e3440",
    "nord1": "#3b4252",
    "nord2": "#434c5e",
    "nord3": "#4c566a",
    "nord4": "#d8dee9",
    "nord5": "#e5e9f0",
    "nord6": "#eceff4",
    "nord7": "#8fbcbb",
    "nord8": "#88c0d0",
    "nord9": "#81a1c1",
    "nord10": "#5e81ac",
    "nord11": "#bf616a",
    "nord12": "#d08770",
    "nord13": "#ebcb8b",
    "nord14": "#a3be8c",
    "nord15": "#b48ead",

    "text": "$nord4",
    "secondaryText": "$nord3",
    "accent": "$nord8",
    "background": "$nord0",
    "caret": "$nord4",
    "caretLine": "rgba(255, 255, 255, 0.03)",
    "textBackgroundSelected": "rgba(136, 192, 208, 0.25)",
    "blockBackgroundSelected": "rgba(136, 192, 208, 0.12)",
    "findMatch": "rgba(235, 203, 139, 0.3)",
    "findMatchCurrent": "rgba(235, 203, 139, 0.5)",
    "handle": "$nord3",
    "guideLine": "$nord1",
    "focusArrow": "$nord3",
    "spelling": "$nord11",
    "grammar": "$nord14"
  },
  "materials": {
    "window": "$nord0",
    "titlebar": "#242933",
    "sidebar": "#242933",
    "editor": "$nord0"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$nord8",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$nord3"
    },
    "blockquote": {
      "color": "$nord14",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$nord4",
      "backgroundColor": "$nord1",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$nord3"
    }
  },
  "runs": {
    "strong": {
      "color": "$nord5",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$nord3",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$nord7",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$nord1"
    },
    "highlight": {
      "backgroundColor": "rgba(235, 203, 139, 0.2)"
    },
    "link": {
      "color": "$nord8",
      "underline": {
        "single": true
      }
    }
  }
}
