{
  "metadata": {
    "name": "High Contrast Dark",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "black": "#000000",
    "white": "#ffffff",
    "lightGray": "#cccccc",
    "mediumGray": "#999999",
    "cyan": "#00ffff",
    "red": "#ff6666",
    "green": "#66ff66",
    "yellow": "#ffff00",

    "text": "$white",
    "secondaryText": "$lightGray",
    "accent": "$cyan",
    "background": "$black",
    "caret": "$white",
    "caretLine": "rgba(255, 255, 255, 0.08)",
    "textBackgroundSelected": "rgba(0, 255, 255, 0.35)",
    "blockBackgroundSelected": "rgba(0, 255, 255, 0.2)",
    "findMatch": "rgba(255, 255, 0, 0.5)",
    "findMatchCurrent": "rgba(255, 255, 0, 0.75)",
    "handle": "$lightGray",
    "guideLine": "#444444",
    "focusArrow": "$mediumGray",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$black",
    "titlebar": "#1a1a1a",
    "sidebar": "#0d0d0d",
    "editor": "$black"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$white",
      "fontWeight": "bold"
    },
    "note": {
      "color": "$lightGray"
    },
    "blockquote": {
      "color": "$lightGray",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$white",
      "backgroundColor": "#1a1a1a",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$lightGray"
    }
  },
  "runs": {
    "strong": {
      "fontWeight": "bold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$mediumGray",
      "strikethrough": {
        "single": true,
        "thick": true
      }
    },
    "code": {
      "color": "$white",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "#1a1a1a"
    },
    "highlight": {
      "backgroundColor": "rgba(255, 255, 0, 0.4)"
    },
    "link": {
      "color": "$cyan",
      "underline": {
        "single": true,
        "thick": true
      }
    }
  }
}
