{
  "metadata": {
    "name": "One Dark",
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "background": "#282c34",
    "backgroundAlt": "#21252b",
    "gutter": "#3b4048",
    "foreground": "#abb2bf",
    "comment": "#5c6370",
    "red": "#e06c75",
    "orange": "#d19a66",
    "yellow": "#e5c07b",
    "green": "#98c379",
    "cyan": "#56b6c2",
    "blue": "#61afef",
    "purple": "#c678dd",

    "text": "$foreground",
    "secondaryText": "$comment",
    "accent": "$blue",
    "caret": "$foreground",
    "caretLine": "rgba(255, 255, 255, 0.04)",
    "textBackgroundSelected": "rgba(97, 175, 239, 0.3)",
    "blockBackgroundSelected": "rgba(97, 175, 239, 0.15)",
    "findMatch": "rgba(229, 192, 123, 0.3)",
    "findMatchCurrent": "rgba(229, 192, 123, 0.5)",
    "handle": "$comment",
    "guideLine": "$gutter",
    "focusArrow": "$comment",
    "spelling": "$red",
    "grammar": "$green"
  },
  "materials": {
    "window": "$background",
    "titlebar": "$backgroundAlt",
    "sidebar": "$backgroundAlt",
    "editor": "$background"
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$red",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$comment"
    },
    "blockquote": {
      "color": "$green",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$foreground",
      "backgroundColor": "$backgroundAlt",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$comment"
    }
  },
  "runs": {
    "strong": {
      "color": "$orange",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$comment",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$purple",
      "fontFamily": "SF Mono",
      "fontTraits": ["monospace"],
      "backgroundColor": "$backgroundAlt"
    },
    "highlight": {
      "backgroundColor": "rgba(229, 192, 123, 0.25)"
    },
    "link": {
      "color": "$blue",
      "underline": {
        "single": true
      }
    }
  }
}
