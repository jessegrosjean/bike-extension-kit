{
  "$schema": "./theme-schema.json",
  "metadata": {
    "name": "Varied Styles Example",
    "version": "1.0.0",
    "author": "Bike Extension Kit"
  },
  "colors": {
    "text": "text",
    "accent": "accent",
    "background": "textBackground",
    "strongColor": "systemBlue",
    "emphasisColor": "systemPurple",
    "strikethroughColor": "systemGray",
    "codeColor": "systemOrange",
    "highlightColor": "systemPink",
    "linkColor": "systemTeal"
  },
  "rows": {
    "body": {
      "fontAdjust": 1.0
    },
    "heading": {
      "fontAdjust": 1.5,
      "fontWeight": "bold"
    },
    "note": {
      "fontAdjust": 0.85
    },
    "blockquote": {
      "fontAdjust": 1.1,
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "fontAdjust": 0.9,
      "fontFamily": "SF Mono"
    },
    "task": {
      "fontAdjust": 0.95
    },
    "orderedList": {
      "fontAdjust": 1.0
    },
    "unorderedList": {
      "fontAdjust": 1.0
    },
    "horizontalRule": {
      "fontAdjust": 0.75
    }
  },
  "runs": {
    "strong": {
      "color": "$strongColor",
      "fontTraits": ["bold"]
    },
    "emphasis": {
      "color": "$emphasisColor",
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$strikethroughColor"
    },
    "code": {
      "color": "$codeColor",
      "fontFamily": "SF Mono"
    },
    "highlight": {
      "color": "$highlightColor"
    },
    "link": {
      "color": "$linkColor"
    }
  }
}
