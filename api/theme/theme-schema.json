{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hogbaysoftware.com/schemas/bike-theme.json",
  "title": "Bike Outliner Theme",
  "description": "JSON schema for Bike Outliner theme files",
  "type": "object",
  "required": [],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the theme",
      "properties": {
        "name": {
          "type": "string",
          "description": "Theme name"
        },
        "version": {
          "type": "string",
          "description": "Theme version"
        },
        "author": {
          "type": "string",
          "description": "Theme author"
        }
      }
    },
    "colors": {
      "type": "object",
      "description": "Color definitions used throughout the theme. Predefined properties such as 'text', 'accent', and 'background' are semantic colors used by Bike. Additional custom colors can also be defined. Colors can be referenced elsewhere using $name syntax.",
      "properties": {
        "text": {
          "$ref": "#/$defs/color",
          "default": "text"
        },
        "accent": {
          "$ref": "#/$defs/color",
          "default": "accent"
        },
        "background": {
          "$ref": "#/$defs/color",
          "default": "textBackground"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "materials": {
      "type": "object",
      "description": "Material definitions used throughout the theme",
      "properties": {
        "window": {
          "$ref": "#/$defs/material"
        },
        "titlebar": {
          "$ref": "#/$defs/material"
        },
        "sidebar": {
          "$ref": "#/$defs/material"
        },
        "editor": {
          "$ref": "#/$defs/material"
        },
        "editorBars": {
          "$ref": "#/$defs/material"
        },
        "inspector": {
          "$ref": "#/$defs/material"
        }
      },
      "additionalProperties": false
    }

    /*
    "rows": {
      "type": "object",
      "description": "Styling for different row types",
      "properties": {
        "body": { "$ref": "#/$defs/textStyle" },
        "heading": { "$ref": "#/$defs/textStyle" },
        "ordered": { "$ref": "#/$defs/textStyle" },
        "unordered": { "$ref": "#/$defs/textStyle" },
        "task": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "object",
      "description": "Styling for text runs and inline formatting",
      "properties": {
        "strong": { "$ref": "#/$defs/textStyle" },
        "emphasis": { "$ref": "#/$defs/textStyle" },
        "strikethrough": { "$ref": "#/$defs/textStyle" },
        "code": { "$ref": "#/$defs/textStyle" },
        "link": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": false
    }
  */
  },
  "$defs": {
    "color": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\$[a-zA-Z0-9_-][a-zA-Z0-9_-]*$",
          "description": "Reference to a color defined in colors ($text or $my-custom-color)"
        },
        {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Hex color code (#RGB, #RGBA, #RRGGBB, or #RRGGBBAA)"
        },
        {
          "type": "string",
          "pattern": "^rgba?\\(.*\\)$",
          "description": "RGB/RGBA color function (rgb(255, 0, 0), rgba(255 0 0 / 50%), rgb(100% 0% 0%))"
        },
        {
          "type": "string",
          "pattern": "^hsla?\\(.*\\)$",
          "description": "HSL/HSLA color function (hsl(120, 100%, 50%), hsla(120deg 100% 50% / 0.5))"
        },
        {
          "type": "string",
          "pattern": "^oklab\\(.*\\)$",
          "description": "OKLab perceptually uniform color (oklab(0.5 0.1 -0.1), oklab(50% 0.1 -0.1 / 80%))"
        },
        {
          "type": "string",
          "pattern": "^oklch\\(.*\\)$",
          "description": "OKLCH cylindrical color (oklch(0.7 0.15 180), oklch(70% 0.15 180deg / 50%))"
        },
        {
          "type": "string",
          "pattern": "^color-mix\\(.*\\)$",
          "description": "Mix two colors (color-mix(in oklch, red, blue), color-mix(in srgb, $primary 30%, white))"
        },
        {
          "type": "string",
          "pattern": "^color-contrast\\(.*\\)$",
          "description": "Select highest contrast color (color-contrast($background vs black, white), color-contrast(gray vs black, white to AA))"
        },
        {
          "type": "string",
          "description": "macOS named colors, these adapt to light/dark mode",
          "enum": [
            "text",
            "textHeader",
            "textBackground",
            "textBackgroundSelected",

            "contentBackgroundSelected",
            "contentBackgroundSelectedUnemphasized",
            "windowBackground",

            "label",
            "labelSecondary",
            "labelTertiary",
            "labelQuaternary",
            "labelQuinary",

            "link",
            "accent",
            "shadow",
            "separator",
            "highlight",
            "findHighlight",

            "systemBlue",
            "systemBrown",
            "systemCyan",
            "systemGray",
            "systemGreen",
            "systemIndigo",
            "systemMint",
            "systemOrange",
            "systemPink",
            "systemPurple",
            "systemRed",
            "systemTeal",
            "systemYellow"
          ]
        },
        {
          "type": "string",
