{
  "$schema": "./theme-schema.json",
  "metadata": {
    "name": "Example Theme",
    "version": "1.0.0",
    "author": "Mr Example",
  },
  "colors": {
    "text": "#000000",
    "accent": "accent",
    "background": "#FFFFFF",
    "titleBackground": "#FFFFFF",
    "accessoryBackground": "#FFFFFF",
    "inspectorBackground": "#FFFFFF",
  }
  "materials": {
     "titlebarBackground": "white",
     "sidebarBackground": {
        "type": "glass"
     },
     "inspectorBackground": {
        "type": "system",
        "style": "header",
        "opacity": 0.15
      },
      "documentPanelsBackground": {
        "type": "system",
        "style": "header",
        "opacity": 0.35
      }
  }

}
